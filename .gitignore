# =============================================================================
# EcoSecurity: o que NUNCA entra no controle de versão.
# Este arquivo foi criado ANTES de qualquer código: um rosto que entra no
# histórico do git não sai mais (é dado biométrico, LGPD art. 5º, II).
# =============================================================================

# --- Segredos ----------------------------------------------------------------
.env
*.key

# --- Dado biométrico ----------------------------------------------------------
# imagens faciais, modelos treinados (contêm os histogramas das faces) e
# qualquer captura feita durante o desenvolvimento ou os experimentos
dados_faciais/
modelo/
*.yml
*.yml.enc
*.yml.gz
capturas/

# --- Saídas geradas -----------------------------------------------------------
resultados/
logs/
# capturas de tela e anotações de trabalho: ficam fora do repositório
scratchpad/
*.sql.dump
*.dump

# --- Python -------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Editores e sistema -------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
ancoras.txt
# documentação de trabalho do grupo: fica só na máquina de cada um
docs/
